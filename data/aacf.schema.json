{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aacf.adriansaxton.com/downloads/aacf.schema.json",
  "title": "AI Adoption Controls Framework data (aacf.json)",
  "description": "The shape of data/aacf.json. The shape has its own version, meta.schema_version: a new field is a minor change, renaming or removing a field is a major change. The framework version (meta.framework.version) tracks the content. Tools should check the major schema version before reading.",
  "type": "object",
  "required": ["meta", "domains"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "framework", "scale", "domains", "owner_roles", "lifecycle_stages", "applicability",
                   "overlays", "statuses", "sources"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "description": "Version of this data shape (semantic versioning).",
          "const": "1.0.0"
        },
        "framework": {
          "type": "object",
          "required": ["name", "short_name", "version", "status", "updated"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "short_name": {"type": "string"},
            "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
            "status": {"type": "string"},
            "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "scale": {
          "type": "object",
          "required": ["baseline_level", "levels"],
          "additionalProperties": false,
          "properties": {
            "baseline_level": {"type": "integer", "minimum": 0, "maximum": 5},
            "levels": {
              "type": "object",
              "propertyNames": {"pattern": "^[0-5]$"},
              "additionalProperties": {"$ref": "#/$defs/named"}
            }
          }
        },
        "domains": {
          "description": "Domain codes and names, in framework order.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/domain_code"},
          "additionalProperties": {
            "type": "object",
            "required": ["name", "file"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "file": {"type": "string", "description": "The domain's source file in framework/domains/."},
              "note": {"type": "string"}
            }
          }
        },
        "owner_roles": {"$ref": "#/$defs/described"},
        "lifecycle_stages": {"$ref": "#/$defs/described"},
        "applicability": {"$ref": "#/$defs/described"},
        "overlays": {
          "description": "Overlays: criteria that apply only to some organisations.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/overlay_code"},
          "additionalProperties": {"$ref": "#/$defs/named"}
        },
        "statuses": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "sources": {
          "description": "The standards and frameworks the controls are cross-referenced to. Only sources whose cross-reference is published appear here.",
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z0-9]+$"},
          "additionalProperties": {
            "type": "object",
            "required": ["name", "url", "layer", "ref_pattern", "provenance"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "url": {"type": "string", "pattern": "^https://"},
              "layer": {"type": "string", "description": "A key of meta.applicability."},
              "ref_pattern": {"type": "string", "description": "Regular expression every ref from this source matches."},
              "provenance": {
                "type": "object",
                "required": ["mapped_by"],
                "additionalProperties": false,
                "properties": {
                  "mapped_by": {"type": "string"},
                  "reviewed_by": {"type": "string"},
                  "checked": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "name", "summary", "controls"],
        "additionalProperties": false,
        "properties": {
          "domain": {"$ref": "#/$defs/domain_code"},
          "name": {"type": "string"},
          "summary": {"type": "string"},
          "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}}
        }
      }
    }
  },
  "$defs": {
    "domain_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "overlay_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "control_id": {"type": "string", "pattern": "^[A-Z]{3}-\\d{2}$"},
    "named": {
      "type": "object",
      "required": ["name", "meaning"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "meaning": {"type": "string"}}
    },
    "described": {
      "description": "Keys mapped to a one-line description.",
      "type": "object",
      "propertyNames": {"pattern": "^[a-z_]+$"},
      "additionalProperties": {"type": "string"}
    },
    "strings": {"type": "array", "items": {"type": "string"}},
    "control": {
      "type": "object",
      "required": ["id", "title", "objective", "rationale", "levels", "criteria", "questions", "evidence", "guidance",
                   "owner", "lifecycle", "applicability", "dependencies", "mappings", "status", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/control_id"},
        "title": {"type": "string"},
        "objective": {"type": "string"},
        "rationale": {"type": "string"},
        "levels": {
          "description": "What each level 1 to 5 looks like for this control. Level 0 (absent) is defined once in meta.scale.",
          "type": "object",
          "propertyNames": {"pattern": "^[1-5]$"},
          "additionalProperties": {"type": "string"}
        },
        "criteria": {
          "description": "The Level 3 criteria: all applicable criteria must be met for the control to reach the baseline.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "applies", "text"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z]{3}-\\d{2}\\.\\d+$"},
              "applies": {
                "description": "\"core\" for every organisation, or the overlay codes the criterion applies to.",
                "oneOf": [
                  {"const": "core"},
                  {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/overlay_code"}}
                ]
              },
              "text": {"type": "string"}
            }
          }
        },
        "questions": {"$ref": "#/$defs/strings"},
        "evidence": {"$ref": "#/$defs/strings"},
        "guidance": {
          "type": "object",
          "required": ["steps", "pitfalls", "artefacts"],
          "additionalProperties": false,
          "properties": {
            "steps": {"$ref": "#/$defs/strings"},
            "pitfalls": {"$ref": "#/$defs/strings"},
            "artefacts": {"$ref": "#/$defs/strings"}
          }
        },
        "owner": {
          "type": "object",
          "required": ["accountable", "contributors"],
          "additionalProperties": false,
          "properties": {
            "accountable": {"type": "string", "description": "A key of meta.owner_roles."},
            "contributors": {"$ref": "#/$defs/strings"}
          }
        },
        "lifecycle": {"$ref": "#/$defs/strings"},
        "applicability": {"type": "string", "description": "A key of meta.applicability."},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/control_id"}},
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "ref", "strength", "label", "confidence"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "description": "A key of meta.sources."},
              "ref": {"type": "string"},
              "strength": {"enum": ["direct", "partial"]},
              "label": {"type": "string", "description": "Our own short description of the source item, never its wording."},
              "confidence": {"enum": ["high", "medium", "low"]}
            }
          }
        },
        "status": {"type": "string", "description": "One of meta.statuses."},
        "replaced_by": {"$ref": "#/$defs/control_id", "description": "Only on retired controls: the live control that replaces it."},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    }
  }
}
